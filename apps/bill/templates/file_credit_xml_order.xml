<?xml version="1.0" encoding="UTF-8"?>
<CreditNote xmlns="urn:oasis:names:specification:ubl:schema:xsd:CreditNote-2"
            xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
            xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
            xmlns:ccts="urn:un:unece:uncefact:documentation:2"
            xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
            xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2"
            xmlns:qdt="urn:oasis:names:specification:ubl:schema:xsd:QualifiedDatatypes-2"
            xmlns:udt="urn:un:unece:uncefact:data:specification:UnqualifiedDataTypesSchemaModule:2"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent></ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
    <cbc:CustomizationID schemeAgencyName="PE:SUNAT">2.0</cbc:CustomizationID>
    <cbc:ID>{{bill.id_char}}</cbc:ID>
    <cbc:IssueDate>{{ bill.sell.issueDate |date:"Y-m-d" }}</cbc:IssueDate>
    {% load tz %}
    <cbc:IssueTime>{{ bill.sell.issueDate | localtime|date:"H:i:s" }}</cbc:IssueTime>
    <cbc:DocumentCurrencyCode>{{ bill.sell.coin.code| upper }}</cbc:DocumentCurrencyCode>
    <!---->
    <cac:DiscrepancyResponse>
        <cbc:ReferenceID>{{bill.id_char}}</cbc:ReferenceID>
        <cbc:ResponseCode>01</cbc:ResponseCode>
        <cbc:Description>ANULACIÓN DE LA OPERACIÓN</cbc:Description>
    </cac:DiscrepancyResponse>
    <cac:BillingReference>
        <cac:InvoiceDocumentReference>
            <cbc:ID>{{bill.sell.relates_to.serie}}-{{bill.sell.relates_to.correlative}}</cbc:ID>
            <cbc:DocumentTypeCode>{{bill.sell.relates_to.documentType.sunat_code}}</cbc:DocumentTypeCode>
        </cac:InvoiceDocumentReference>
    </cac:BillingReference>
    <!---->
    <cac:Signature>
        <cbc:ID>{{bill.id_char}}</cbc:ID>
        <cac:SignatoryParty>
            <cac:PartyIdentification><cbc:ID>{{settings.RUC}}</cbc:ID></cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name><![CDATA[{{ settings.enterprise_name }}]]></cbc:Name>
            </cac:PartyName>
        </cac:SignatoryParty>
        <cac:DigitalSignatureAttachment>
            <cac:ExternalReference>
                <cbc:URI>{{settings.RUC}}</cbc:URI>
            </cac:ExternalReference>
        </cac:DigitalSignatureAttachment>
    </cac:Signature>
    <cac:AccountingSupplierParty>
        <cbc:CustomerAssignedAccountID>{{ settings.RUC }}</cbc:CustomerAssignedAccountID>
        <cbc:AdditionalAccountID>6</cbc:AdditionalAccountID>
        <cac:Party>
            <cac:PartyIdentification>
                <!-- Ruc del Emisor -->
                <!-- Tipo documento: @schemeID = 6 (RUC - Catálogo 06) -->
                <cbc:ID schemeID="6"
                        schemeName="Documento de Identidad"
                        schemeAgencyName="PE:SUNAT"
                        schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06">{{settings.RUC}}</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name><![CDATA[{{ settings.enterprise_name }}]]></cbc:Name>
            </cac:PartyName>
            <cac:PartyTaxScheme>
                <cbc:RegistrationName><![CDATA[{{ settings.sunat_name }}]]></cbc:RegistrationName>
                <cbc:CompanyID schemeID="6" schemeName="SUNAT:Identificador de Documento de Identidad"
                               schemeAgencyName="PE:SUNAT"
                               schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06">{{ settings.RUC }}
                </cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>{{settings.RUC}}</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>{{ settings.sunat_name }}</cbc:RegistrationName>
                <cac:RegistrationAddress>
                    <cbc:AddressTypeCode>0000<!--{{ settings.location_code }}--></cbc:AddressTypeCode>
                </cac:RegistrationAddress>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>
    <cac:AccountingCustomerParty>
        <cbc:CustomerAssignedAccountID>{{ bill.client.document }}</cbc:CustomerAssignedAccountID>
        <cbc:AdditionalAccountID>{{ bill.document_type_client.code }}</cbc:AdditionalAccountID>
        <cac:Party>
            <cac:PartyIdentification>
                <!-- Documento del receptor -->
                <!-- Tipo documento: @schemeID = 6 (RUC - Catálogo 06) -->
                <cbc:ID schemeID="{{bill.document_type_client.code}}"
                        schemeName="Documento de Identidad"
                        schemeAgencyName="PE:SUNAT"
                        schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06">{{bill.client.document}}</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyLegalEntity>
                <!-- Razon social del receptor -->
                <cbc:RegistrationName><![CDATA[{{bill.client.name}}]]></cbc:RegistrationName>
                <cac:RegistrationAddress>
                    <cbc:ID>040801</cbc:ID>
                    <cac:AddressLine>
                        <!-- Dirección completa del receptor -->
                        <cbc:Line><![CDATA[{{bill.client.address}}]]></cbc:Line>
                    </cac:AddressLine>
                    <cac:Country>
                        <!-- Codigo del pais -->
                        <cbc:IdentificationCode listID="ISO 3166-1"
                                                listName="Country"
                                                listAgencyName="United Nations Economic Commission for Europe">PE</cbc:IdentificationCode>
                    </cac:Country>
                </cac:RegistrationAddress>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>
    {% load bill_extras %}
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.tax | floatformat:2 }}</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.amount | floatformat:2 }}</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.tax | floatformat:2 }}</cbc:TaxAmount>
            <cac:TaxCategory>
                <cac:TaxScheme>
                    <cbc:ID schemeName="Codigo de tributos" schemeAgencyName="PE:SUNAT" schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo05">1000</cbc:ID>
                    <cbc:Name>IGV</cbc:Name>
                    <cbc:TaxTypeCode>VAT</cbc:TaxTypeCode>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.amount | floatformat:2 }}</cbc:LineExtensionAmount>
        <cbc:TaxInclusiveAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.tax |add:bill.amount | floatformat:2 }}</cbc:TaxInclusiveAmount>
        <cbc:AllowanceTotalAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.sell.totalDiscount | floatformat:2 }}</cbc:AllowanceTotalAmount>
        <cbc:ChargeTotalAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ 0 | floatformat:2 }}</cbc:ChargeTotalAmount>
        <cbc:PayableAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ bill.amount|add:bill.tax |res:bill.sell.totalDiscount | floatformat:2 }}</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    {% for detail in bill.details %}
    <cac:CreditNoteLine>
        <cbc:ID>{{ forloop.counter }}</cbc:ID>
        <cbc:CreditedQuantity unitCode="{{ detail.product.unit.isocode }}">{{ detail.quantity | floatformat:2 }}</cbc:CreditedQuantity>
        <cbc:LineExtensionAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ detail.total | floatformat:2 }}</cbc:LineExtensionAmount>
        <cac:PricingReference>
            <cac:AlternativeConditionPrice>
                <cbc:PriceAmount currencyID="PEN">{{ detail.total |add:detail.igv |div:detail.quantity | floatformat:2 }}</cbc:PriceAmount>
                <cbc:PriceTypeCode>01</cbc:PriceTypeCode>
            </cac:AlternativeConditionPrice>
        </cac:PricingReference>
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ detail.igv | floatformat:2 }}</cbc:TaxAmount>
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ detail.total | floatformat:2 }}</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ detail.igv | floatformat:2 }}</cbc:TaxAmount>
                <cac:TaxCategory>
                    <cbc:Percent>{{ detail.igv |div:detail.total |mul:100 | floatformat:1 }}</cbc:Percent>
                    <cbc:TaxExemptionReasonCode>10</cbc:TaxExemptionReasonCode>
                    <cac:TaxScheme>
                        <cbc:ID schemeName="Codigo de tributos" schemeAgencyName="PE:SUNAT" schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo05">1000</cbc:ID>
                        <cbc:Name>IGV</cbc:Name>
                        <cbc:TaxTypeCode>VAT</cbc:TaxTypeCode>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
        </cac:TaxTotal>
        <cac:Item>
            <cbc:Description><![CDATA[{{ detail.product.name }}]]></cbc:Description>
            <cac:SellersItemIdentification>
                <cbc:ID>{{ detail.product.id }}</cbc:ID>
            </cac:SellersItemIdentification>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="{{ bill.sell.coin.code| upper }}">{{ detail.unitaryCost | floatformat:2 }}</cbc:PriceAmount>
        </cac:Price>
    </cac:CreditNoteLine>
    {% endfor %}
</CreditNote>
