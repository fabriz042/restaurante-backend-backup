<?xml version="1.0" encoding="UTF-8" ?>
<Invoice xmlns="urn:oasis:names:specification:ubl:schema:xsd:Invoice-2"
         xmlns:cac="urn:oasis:names:specification:ubl:schema:xsd:CommonAggregateComponents-2"
         xmlns:cbc="urn:oasis:names:specification:ubl:schema:xsd:CommonBasicComponents-2"
         xmlns:ds="http://www.w3.org/2000/09/xmldsig#"
         xmlns:ext="urn:oasis:names:specification:ubl:schema:xsd:CommonExtensionComponents-2">
    <ext:UBLExtensions>
        <ext:UBLExtension>
            <ext:ExtensionContent></ext:ExtensionContent>
        </ext:UBLExtension>
    </ext:UBLExtensions>
    <cbc:UBLVersionID>2.1</cbc:UBLVersionID>
    <cbc:CustomizationID schemeAgencyName="PE:SUNAT">2.0</cbc:CustomizationID>
    <cbc:ID>{{bill.bill_name}}</cbc:ID>
    <cbc:IssueDate>{{ bill.order.start_datetime |date:"Y-m-d" }}</cbc:IssueDate>
    {% load tz %}
    <cbc:IssueTime>{{ bill.order.start_datetime | localtime|date:"H:i:s" }}</cbc:IssueTime>
    <cbc:InvoiceTypeCode listID="0101">03</cbc:InvoiceTypeCode>
    <!--cbc:Note languageLocaleID="1000">
        <![CDATA[ CIENTO DIECIOCHO CON 00/100 ]]>
    </cbc:Note-->
    <cbc:DocumentCurrencyCode>{{ bill.order.currency.code| upper }}</cbc:DocumentCurrencyCode>
    <cac:Signature>
        <cbc:ID>{{bill.bill_name}}</cbc:ID>
        <cac:SignatoryParty>
            <cac:PartyIdentification><cbc:ID>{{bill.order.restaurant.ruc}}</cbc:ID></cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name><![CDATA[{{ bill.order.restaurant.business_name }}]]></cbc:Name>
            </cac:PartyName>
        </cac:SignatoryParty>
        <cac:DigitalSignatureAttachment>
            <cac:ExternalReference>

                <cbc:URI>{{bill.bill_name}}</cbc:URI>

            </cac:ExternalReference>
        </cac:DigitalSignatureAttachment>
    </cac:Signature>
    <cac:AccountingSupplierParty>
        <cbc:CustomerAssignedAccountID>{{ bill.order.restaurant.ruc }}</cbc:CustomerAssignedAccountID>
        <cbc:AdditionalAccountID>6</cbc:AdditionalAccountID>
        <cac:Party>
            <cac:PartyIdentification>
                <!-- Ruc del Emisor -->
                <!-- Tipo documento: @schemeID = 6 (RUC - Catálogo 06) -->
                <cbc:ID schemeID="6"
                        schemeName="Documento de Identidad"
                        schemeAgencyName="PE:SUNAT"
                        schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06">{{bill.order.restaurant.ruc}}</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyName>
                <cbc:Name><![CDATA[{{ bill.order.restaurant.business_name }}]]></cbc:Name>
            </cac:PartyName>
            <cac:PartyTaxScheme>
                <cbc:RegistrationName><![CDATA[{{ bill.order.restaurant.business_name }}]]></cbc:RegistrationName>
                <cbc:CompanyID schemeID="6" schemeName="SUNAT:Identificador de Documento de Identidad"
                               schemeAgencyName="PE:SUNAT"
                               schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06">{{ bill.order.restaurant.ruc }}
                </cbc:CompanyID>
                <cac:TaxScheme>
                    <cbc:ID>{{bill.order.restaurant.ruc}}</cbc:ID>
                </cac:TaxScheme>
            </cac:PartyTaxScheme>
            <cac:PartyLegalEntity>
                <cbc:RegistrationName>{{ bill.order.restaurant.business_name }}</cbc:RegistrationName>
                <cac:RegistrationAddress>
                    <cbc:AddressTypeCode>{{ bill.order.restaurant.billing_settings.location_code }}</cbc:AddressTypeCode>
                </cac:RegistrationAddress>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingSupplierParty>
    <cac:AccountingCustomerParty>
        <cbc:CustomerAssignedAccountID>{{ bill.order.client.document }}</cbc:CustomerAssignedAccountID>
        <cbc:AdditionalAccountID>{{ bill.order.client.document_type.code }}</cbc:AdditionalAccountID>
        <cac:Party>
            <cac:PartyIdentification>
                <!-- Documento del receptor -->
                <!-- Tipo documento: @schemeID = 6 (RUC - Catálogo 06) -->
                <cbc:ID schemeID="{{bill.order.client.document_type.code}}"
                        schemeName="Documento de Identidad"
                        schemeAgencyName="PE:SUNAT"
                        schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo06">{{bill.order.client.document}}</cbc:ID>
            </cac:PartyIdentification>
            <cac:PartyLegalEntity>
                <!-- Razon social del receptor -->
                <cbc:RegistrationName><![CDATA[{{bill.order.client.name}}]]></cbc:RegistrationName>
                <cac:RegistrationAddress>
                    <cbc:ID>040801</cbc:ID>
                    <cac:AddressLine>
                        <!-- Dirección completa del receptor -->
                        <cbc:Line><![CDATA[{{bill.order.client.address}}]]></cbc:Line>
                    </cac:AddressLine>
                    <cac:Country>
                        <!-- Codigo del pais -->
                        <cbc:IdentificationCode listID="ISO 3166-1"
                                                listName="Country"
                                                listAgencyName="United Nations Economic Commission for Europe">PE</cbc:IdentificationCode>
                    </cac:Country>
                </cac:RegistrationAddress>
            </cac:PartyLegalEntity>
        </cac:Party>
    </cac:AccountingCustomerParty>
    <cac:PaymentTerms>
        <cbc:ID>FormaPago</cbc:ID>
        <cbc:PaymentMeansID>Contado</cbc:PaymentMeansID>
    </cac:PaymentTerms>
    <cac:TaxTotal>
        <cbc:TaxAmount currencyID="{{ bill.order.currency.code| upper }}">{{ bill.order.igv | stringformat:".2f" }}</cbc:TaxAmount>
        <cac:TaxSubtotal>
            <cbc:TaxableAmount currencyID="{{ bill.order.currency.code| upper }}">{{ bill.order.sub_total | stringformat:".2f"}}</cbc:TaxableAmount>
            <cbc:TaxAmount currencyID="{{ bill.order.currency.code| upper }}">{{ bill.order.igv | stringformat:".2f" }}</cbc:TaxAmount>
            <cac:TaxCategory>
                <!--cbc:ID schemeID="UN/ECE 5305" schemeName="Tax Category Identifier"
                        schemeAgencyName="United Nations Economic Commission for Europe">S</cbc:ID-->
                <cac:TaxScheme>
                    <cbc:ID schemeName="Codigo de tributos" schemeAgencyName="PE:SUNAT" schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo05">1000</cbc:ID>
                    <cbc:Name>IGV</cbc:Name>
                    <cbc:TaxTypeCode>VAT</cbc:TaxTypeCode>
                </cac:TaxScheme>
            </cac:TaxCategory>
        </cac:TaxSubtotal>
    </cac:TaxTotal>
    <cac:LegalMonetaryTotal>
        <cbc:LineExtensionAmount currencyID="{{ bill.order.currency.code| upper }}">{{ bill.order.sub_total | stringformat:".2f" }}</cbc:LineExtensionAmount>
        <cbc:TaxInclusiveAmount currencyID="{{ bill.order.currency.code| upper }}">{{ bill.order.total | stringformat:".2f" }}</cbc:TaxInclusiveAmount>
        <cbc:AllowanceTotalAmount currencyID="{{ bill.order.currency.code| upper }}">{{ 0 | stringformat:".2f" }}</cbc:AllowanceTotalAmount>
        <cbc:ChargeTotalAmount currencyID="{{ bill.order.currency.code| upper }}">{{ 0 | stringformat:".2f" }}</cbc:ChargeTotalAmount>
        <cbc:PayableAmount currencyID="{{ bill.order.currency.code| upper }}">{{ bill.order.total | stringformat:".2f" }}</cbc:PayableAmount>
    </cac:LegalMonetaryTotal>
    {% for detail in bill.order.details_active %}
    <cac:InvoiceLine>
        <cbc:ID>{{ forloop.counter }}</cbc:ID>
        <cbc:InvoicedQuantity unitCode="NIU">{{ detail.quantity | stringformat:".2f" }}</cbc:InvoicedQuantity>
        <cbc:LineExtensionAmount currencyID="{{ bill.order.currency.code| upper }}">{{ detail.total_no_tax | stringformat:".2f"  }}</cbc:LineExtensionAmount>
        <cac:PricingReference>
            <cac:AlternativeConditionPrice>
                <cbc:PriceAmount currencyID="{{ bill.order.currency.code| upper }}">{{ detail.unit_price | stringformat:".2f"  }}</cbc:PriceAmount>
                <cbc:PriceTypeCode>01</cbc:PriceTypeCode>
            </cac:AlternativeConditionPrice>
        </cac:PricingReference>
        <cac:TaxTotal>
            <cbc:TaxAmount currencyID="{{ bill.order.currency.code| upper }}">{{ detail.igv_total | stringformat:".2f"  }}</cbc:TaxAmount>
            <cac:TaxSubtotal>
                <cbc:TaxableAmount currencyID="{{ bill.order.currency.code| upper }}">{{ detail.total_no_tax | stringformat:".2f"  }}</cbc:TaxableAmount>
                <cbc:TaxAmount currencyID="{{ bill.order.currency.code| upper }}">{{ detail.igv_total | stringformat:".2f"  }}</cbc:TaxAmount>
                <cac:TaxCategory>
                    <!--cbc:ID schemeID="UN/ECE 5305" schemeName="Tax Category Identifier"
                            schemeAgencyName="United Nations Economic Commission for Europe">S</cbc:ID-->
                    <cbc:Percent>{{ bill.order.igv_percent_formatted | stringformat:".2f"}}</cbc:Percent>
                    <cbc:TaxExemptionReasonCode>10</cbc:TaxExemptionReasonCode>
                    <cac:TaxScheme>
                        <cbc:ID schemeName="Codigo de tributos" schemeAgencyName="PE:SUNAT" schemeURI="urn:pe:gob:sunat:cpe:see:gem:catalogos:catalogo05">1000</cbc:ID>
                        <cbc:Name>IGV</cbc:Name>
                        <cbc:TaxTypeCode>VAT</cbc:TaxTypeCode>
                    </cac:TaxScheme>
                </cac:TaxCategory>
            </cac:TaxSubtotal>
        </cac:TaxTotal>
        <cac:Item>
            <cbc:Description><![CDATA[{{ detail.menu_item.menu_item_name }}]]></cbc:Description>
            <cac:SellersItemIdentification>
                <cbc:ID>{{ detail.menu_item.id }}</cbc:ID>
            </cac:SellersItemIdentification>
        </cac:Item>
        <cac:Price>
            <cbc:PriceAmount currencyID="{{ bill.order.currency.code| upper }}">{{ detail.prize_net | stringformat:".2f" }}</cbc:PriceAmount>
        </cac:Price>
    </cac:InvoiceLine>
    {% endfor %}
</Invoice>
